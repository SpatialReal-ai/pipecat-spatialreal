# SpatialReal credentials
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
SPATIALREAL_AVATAR_ID=

# Optional: point the bot at another SpatialReal deployment than production (us-west); set both.
# The console API root, where session tokens come from (a value ending in /v1/console is read the
# same way). The token route gets the page's token there too, and tells the page to load the
# avatar from that deployment.
# SPATIALREAL_CONSOLE_ENDPOINT=https://api.spatialreal.cloud
# The full driveningress URL, path included. A bare origin is accepted too: the path is added.
# SPATIALREAL_INGRESS_ENDPOINT=https://driven.us-west.spatialreal.cloud/v2/driveningress

# The example bot (examples/bot.py)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GEMINI_API_KEY=
# Optional: another Cartesia voice (default: a voice Pipecat's own documentation uses)
# CARTESIA_VOICE_ID=

# The web origins allowed to read the replies of Pipecat's development runner, comma-separated.
# Unset, any page open in your browser may; this allows only the example's pages, which the bot
# serves. The token route refuses other origins whatever this says. While it is set, the runner
# also refuses a WebSocket that sends no Origin; Pipecat's eval harness sends none, so empty this
# to run one.
PIPECAT_ALLOWED_ORIGINS=http://localhost:7860

# Daily transport (uv run python examples/bot.py -t daily). The runner creates a room per session;
# set DAILY_ROOM_URL to reuse one room instead.
DAILY_API_KEY=
# DAILY_ROOM_URL=

# LiveKit transport (uv run python examples/bot.py -t livekit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
