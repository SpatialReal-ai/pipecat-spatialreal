.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.DS_Store
.env

# Libraries resolve fresh in CI (see ci.yml) instead of pinning through a lock file.
uv.lock

# The contract lives in shared-proto; this repo holds generated code only. The codegen
# workflow refuses any committed .proto, this keeps one from being added by accident.
*.proto

# The example page imports the web SDK's Pipecat session from here; copy it in as
# examples/client/README.md describes (the session is not on npm yet).
examples/client/vendor/

# hack/sync-sim/thrsearch_stall.py's data cache, if one is pointed into the repo.
hack/sync-sim/*.pkl
